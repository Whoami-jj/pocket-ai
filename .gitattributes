# Normalize text files
* text=auto

# Unix shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle / Android properties
*.properties text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Flutter / Dart
*.dart text eol=lf

# YAML / JSON / XML
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.aar binary
*.so binary